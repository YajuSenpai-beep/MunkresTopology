% ---------- 插图统一命令 ----------
% \munkresfig[width]{filename}[Figure label][font command]
%   宽度默认 0.8\textwidth；label 可省略；font 默认 粗体+slanted
%   示例: \munkresfig[1.0]{1.1}[Figure 1.1]             → 粗体+slanted（默认）
%         \munkresfig[1.0]{1.1}[Figure 1.1][\upshape]   → 正常字体（覆盖默认）
\NewDocumentCommand{\munkresfig}{O{0.8} m o o}{%
  \begin{center}%
    \includegraphics[width=#1\linewidth]{images/#2.png}%
    \IfValueT{#3}{\par\vskip 0.5em \IfValueTF{#4}{#4{#3}}{\textbf{\textsl{#3}}}\par}%
  \end{center}%
}

