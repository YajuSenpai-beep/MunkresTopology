% 编译命令: makeindex -s Topology_by_Munkres.ist Topology_by_Munkres.idx
% ---------- 索引自定义格式 ----------
\newcommand{\idxfmt}[1]{\textbf{\textsl{#1}}}       % 索引条目正文字体格式
\NewDocumentCommand{\idx}{om}{%
  \IfNoValueTF{#1}
    {\index{#2}\idxfmt{#2}}      % \idx{key} — display = key
    {\index{#2}\idxfmt{#1}}      % \idx[display]{key} — separate display
}
\newcommand{\idxmath}[2]{\index{#1@#2}\idxfmt{#2}} % 数学符号索引条目（#1=排序键,#2=显示）
