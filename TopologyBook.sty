% 统一章节节命令: \booksection{num}{title} 或 \booksection*{num}{title}[suffix]
%   *   = optional section (asterisk in body + TOC)
%   num = section number
%   title = section title
%   suffix = optional dagger, e.g. [\protect\sectionDagger]
\NewDocumentCommand{\booksection}{s m m o}{%
  \stepcounter{section}%
  \IfBooleanTF{#1}
    {\section*{\raisebox{0.15ex}{\small *}§ #2\ #3\IfValueT{#4}{ #4}}}
    {\section*{§ #2\ #3\IfValueT{#4}{ #4}}}%
  \phantomsection
  \IfBooleanTF{#1}
    {\addcontentsline{toc}{section}{\llap{\raisebox{0.15ex}{\small *}}#2\quad#3}}
    {\addcontentsline{toc}{section}{#2\quad#3}}%
  \markright{#3}%
}
% Supplementary exercises: *-prefixed, no section number
\NewDocumentCommand{\suppsection}{m}{%
  \section*{\raisebox{0.15ex}{\small *}\ #1}%
  \phantomsection
  \addcontentsline{toc}{section}{\llap{\raisebox{0.15ex}{\small *}}#1}%
  \markright{#1}%
}
\titleformat{\subsection}
  {\normalfont\normalsize\bfseries}
  {}
  {0pt}
  {}
\titlespacing*{\subsection}{0pt}{\parskip}{0pt}

